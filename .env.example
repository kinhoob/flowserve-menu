# Browser-safe Supabase values (never use a service-role key in VITE_*).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public HTTPS origin. Required for exported QR Codes.
VITE_PUBLIC_APP_URL=
APP_URL=

# Server policy must match VITE_PAYMENTS_CLIENT_TOKEN. Defaults to live.
PAYMENTS_ENVIRONMENT=live
VITE_PAYMENTS_CLIENT_TOKEN=
STRIPE_LIVE_API_KEY=
STRIPE_SANDBOX_API_KEY=
LOVABLE_API_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=

# Optional remote integration tests. Use an isolated Supabase project only.
RUN_INTEGRATION_TESTS=0
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_RESTAURANT_ID=
TEST_MENU_ITEM_ID=
TEST_TABLE_LABEL=
TEST_STAFF_SLUG=
TEST_STAFF_PIN=
